{% extends 'base.html.twig' %}

{# No cachear el login: evita que Turbo reutilice un token CSRF caducado. #}
{% block head_meta %}<meta name="turbo-cache-control" content="no-cache">{% endblock %}

{% block title %}Entrar · Anuska Complementos{% endblock %}

{% block auth_body %}
    <div class="auth-card">
        <div class="auth-card__brand">
            ANUSKA
            <small>Complementos</small>
        </div>

        {% if error %}
            <div class="flash flash--error" style="margin-bottom:18px">
                {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>
        {% endif %}

        <form method="post" data-turbo="false">
            <div class="form-row">
                <label for="inputEmail">Email</label>
                <input type="email" id="inputEmail" name="_username" value="{{ last_username }}" autocomplete="email" required autofocus>
            </div>

            <div class="form-row" data-controller="password-toggle">
                <label for="inputPassword">Contraseña</label>
                <div class="pw-field">
                    <input type="password" id="inputPassword" name="_password" autocomplete="current-password" required data-password-toggle-target="input">
                    <button type="button" class="pw-toggle" data-action="password-toggle#toggle" data-password-toggle-target="label">Mostrar</button>
                </div>
            </div>

            <div class="checkbox-row">
                <input type="checkbox" id="rememberMe" name="_remember_me">
                <label for="rememberMe">Mantener la sesión iniciada</label>
            </div>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <button class="btn btn--primary" type="submit" style="width:100%;justify-content:center">Entrar</button>
        </form>
    </div>
{% endblock %}
