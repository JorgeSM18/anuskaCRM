{% extends 'base.html.twig' %}

{% block title %}Pedidos · Anuska Complementos{% endblock %}

{% block body %}
    <div class="page-head">
        <h1>Pedidos{% if supplier %} · {{ supplier.brandName }}{% endif %}</h1>
        <div class="page-head__actions">
            <a class="btn btn--ghost" href="{{ path('purchase_order_export', app.request.query.all) }}">Exportar</a>
        </div>
    </div>

    <form method="get" action="{{ path('purchase_order_index') }}" data-controller="autosubmit"
          class="filter-bar">
        {% if supplier %}<input type="hidden" name="supplier" value="{{ supplier.id }}">{% endif %}
        <select name="status" data-action="autosubmit#submit" class="filter-select">
            <option value="">Todos los estados</option>
            {% for case in enum('App\\Enum\\OrderStatus').cases() %}
                <option value="{{ case.value }}" {{ status == case ? 'selected' }}>{{ case.label() }}</option>
            {% endfor %}
        </select>
        <div class="search">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input type="search" name="season" value="{{ season }}" placeholder="Temporada…">
        </div>
        <button class="btn btn--ghost" type="submit">Filtrar</button>
    </form>

    <div class="card">
        {% if total == 0 %}
            <div class="empty-hint">No hay pedidos que coincidan.</div>
        {% else %}
            <table class="table">
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Nº</th>
                        <th>Proveedor</th>
                        <th>Temporada</th>
                        <th>Estado</th>
                        <th style="text-align:right">Importe</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {% for order in orders %}
                        <tr>
                            <td class="text-muted">{{ order.orderedAt ? order.orderedAt|date('d/m/Y') : '—' }}</td>
                            <td><a href="{{ path('purchase_order_show', {id: order.id}) }}"><strong>{{ order.number }}</strong></a></td>
                            <td><a href="{{ path('supplier_show', {id: order.supplier.id}) }}">{{ order.supplier.brandName }}</a></td>
                            <td class="text-muted">{{ order.season ?: '—' }}</td>
                            <td><span class="badge badge--{{ order.status.badge }}">{{ order.status.label }}</span></td>
                            <td style="text-align:right">{{ (order.finalAmount ?? order.estimatedAmount)|money }}</td>
                            <td style="text-align:right"><a class="btn btn--ghost" href="{{ path('purchase_order_show', {id: order.id}) }}">Ver</a></td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>

    {% if pages > 1 %}
        <div style="display:flex;gap:6px;justify-content:center;margin-top:18px">
            {% for p in 1..pages %}
                {% set params = {page: p} %}
                {% if status %}{% set params = params|merge({status: status.value}) %}{% endif %}
                {% if season %}{% set params = params|merge({season: season}) %}{% endif %}
                {% if supplier %}{% set params = params|merge({supplier: supplier.id}) %}{% endif %}
                <a class="btn {{ p == page ? 'btn--primary' : 'btn--ghost' }}" href="{{ path('purchase_order_index', params) }}">{{ p }}</a>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
