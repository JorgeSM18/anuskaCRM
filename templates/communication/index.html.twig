{% extends 'base.html.twig' %}

{% block title %}Comunicaciones · Anuska Complementos{% endblock %}

{% block body %}
    <div class="page-head">
        <h1>Comunicaciones{% if supplier %} · {{ supplier.brandName }}{% endif %}</h1>
    </div>

    <form method="get" action="{{ path('communication_index') }}" data-controller="autosubmit"
          class="filter-bar">
        {% if supplier %}<input type="hidden" name="supplier" value="{{ supplier.id }}">{% endif %}
        <select name="type" data-action="autosubmit#submit" class="filter-select">
            <option value="">Todos los tipos</option>
            {% for case in enum('App\\Enum\\CommunicationType').cases() %}
                <option value="{{ case.value }}" {{ type == case ? 'selected' }}>{{ case.label() }}</option>
            {% endfor %}
        </select>
        <label class="checkbox-row" style="margin:0">
            <input type="checkbox" name="pending" value="1" data-action="autosubmit#submit" {{ pendingOnly ? 'checked' }}>
            Solo pendientes de respuesta
        </label>
    </form>

    <div class="card">
        <div class="card__body">
            {% if total == 0 %}
                <div class="empty-hint">No hay comunicaciones que coincidan.</div>
            {% else %}
                {% for communication in communications %}
                    {{ include('_partials/_communication_item.html.twig', {show_supplier: true}) }}
                {% endfor %}
            {% endif %}
        </div>
    </div>

    {% if pages > 1 %}
        <div style="display:flex;gap:6px;justify-content:center;margin-top:18px">
            {% for p in 1..pages %}
                {% set params = {page: p} %}
                {% if type %}{% set params = params|merge({type: type.value}) %}{% endif %}
                {% if pendingOnly %}{% set params = params|merge({pending: 1}) %}{% endif %}
                {% if supplier %}{% set params = params|merge({supplier: supplier.id}) %}{% endif %}
                <a class="btn {{ p == page ? 'btn--primary' : 'btn--ghost' }}" href="{{ path('communication_index', params) }}">{{ p }}</a>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
