{% extends 'base.html.twig' %}

{% block title %}Buscar · Anuska Complementos{% endblock %}

{% block body %}
    <div class="page-head">
        <h1>{% if q %}Resultados para "{{ q }}"{% else %}Buscar{% endif %}</h1>
    </div>

    {% if q|length < 2 %}
        <div class="card"><div class="empty-hint">Escribe al menos 2 caracteres para buscar.</div></div>
    {% elseif groups is empty %}
        <div class="card"><div class="empty-hint">No se ha encontrado nada para "{{ q }}".</div></div>
    {% else %}
        <div style="display:grid;gap:18px">
            {% for group in groups %}
                <div class="card">
                    <div class="card__body">
                        <h3 style="margin:0 0 8px">{{ group.label }}</h3>
                        {% for hit in group.hits %}
                            <a href="{{ hit.url }}" style="display:flex;gap:10px;padding:8px 0;border-bottom:1px solid var(--line);color:inherit;text-decoration:none">
                                <span style="flex:1"><strong>{{ hit.title }}</strong></span>
                                {% if hit.subtitle %}<span class="text-muted" style="font-size:13px">{{ hit.subtitle }}</span>{% endif %}
                            </a>
                        {% endfor %}
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
